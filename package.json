{
  "name": "hackmatrix-trustmatrix",
  "version": "1.0.0",
  "scripts": {
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "node server/test-section10-deliverables.js && node server/test-section11-evaluation.js && node server/test-section12-extensions.js",
    "test:eval": "node server/test-section11-evaluation.js",
    "test:deliverables": "node server/test-section10-deliverables.js",
    "test:extensions": "node server/test-section12-extensions.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
